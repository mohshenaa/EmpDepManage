@model EmpDepManage.Models.Employee
@{
    ViewBag.Title = "Create";
}

<h2>Create</h2>
@using (Html.BeginForm())
{
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div>
        @Html.LabelFor(a => a.EmpName)
        @Html.TextBoxFor(a => a.EmpName)
    </div>
    <br />
    <div>
        @Html.LabelFor(a => a.Email)
        @Html.TextBoxFor(a => a.Email)
        @Html.ValidationMessageFor(a => a.Email)
    </div>
    <br />
    <div>
        @Html.LabelFor(a => a.PhoneNumber)
        @Html.TextBoxFor(a => a.PhoneNumber)
        @Html.ValidationMessageFor(a => a.PhoneNumber)
    </div>
    <br />
    <div>
        @Html.LabelFor(a => a.Salary)
        @Html.TextBoxFor(a => a.Salary)
    </div>
    <br />
    <div>
        @Html.LabelFor(a => a.Department)
        @Html.DropDownList("DepId",(SelectList)ViewBag.department)
    </div>
    <br />
    <div>
        <button type="submit">Save</button>
    </div>
    <br />
}
@Html.ActionLink("Back to list", "Index")
