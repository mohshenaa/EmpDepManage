@model EmpDepManage.Models.Department
@{
    ViewBag.Title = "Edit";
}

<h2>Edit</h2>

@using (Html.BeginForm())
{
    @Html.HiddenFor(a=>a.DepId)
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div>
        @Html.LabelFor(a => a.DepName)
        @Html.TextBoxFor(a => a.DepName)
        @Html.ValidationMessageFor(a => a.DepName, "", new { @class = "text-danger" })
    </div>
    <br />
    <div>
        <button type="submit">Update</button>
    </div>
    <br />
}
@Html.ActionLink("Back to list", "Index")